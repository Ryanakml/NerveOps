{
  "name": "@nerveops/control-plane",
  "private": true,
  "version": "0.1.0",
  "description": "NerveOps Control Plane shell (NestJS) — M0-01, no domain behavior",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npx ts-node src/main.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "integration-test": "bash ../../scripts/check-shell-http.sh control-plane http://localhost:3001/health"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
