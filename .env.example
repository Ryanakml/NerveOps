# NerveOps shared configuration-name contract (M0-01)
# No secrets are committed. Copy to `.env` locally and fill values.
# See docs/config-contract.md for ownership and meanings.
# This file owns NAMES only; #2 owns migration/database behavior, #3 owns Compose wiring.

# --- Web Product (Next.js) ---
WEB_PORT=3100
# Public base URL of the Control Plane as seen by server-side web code (no secret).
CONTROL_PLANE_BASE_URL=http://localhost:3001

# --- Control Plane (NestJS) ---
CONTROL_PLANE_PORT=3001
# CORS origin allowed for browser development (local-only default).
WEB_BASE_URL=http://localhost:3100
# Internal Runtime API base URL used by Control Plane server code (service-to-service).
RUNTIME_API_BASE_URL=http://localhost:8000
# Internal service-auth token name (value lives only in local `.env`, never committed).
# CONTROL_PLANE_TO_RUNTIME_TOKEN=

# --- Investigation Runtime API (FastAPI) ---
RUNTIME_API_PORT=8000

# --- Runtime worker (Python) ---
RUNTIME_WORKER_PORT=8001
# Poll/heartbeat cadence in seconds (shell default; lease tuning is UNRESOLVED per blueprint §126).
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=5

# --- Celery worker (background only, never authoritative) ---
# Broker URL name only (local default is redis://localhost:6379/0; value not committed here).
# CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=cache+memory://

# --- Shared infrastructure names (wired fully in #3) ---
# DATABASE_URL=postgresql+psycopg://nerveops:nerveops@localhost:5432/nerveops
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=nerveops-blobs
# OLLAMA_BASE_URL=http://localhost:11434
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Observability (optional, never required for core shells) ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LOG_LEVEL=info
NERVEOPS_ENV=development
NERVEOPS_SHELL_VERSION=0.1.0-m0-01
